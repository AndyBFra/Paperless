# Nach .env kopieren und anpassen. Siehe Kommentare in einer echten .env.

COMPOSE_PROJECT_NAME=paperless

PAPERLESS_PORT=8000

PAPERLESS_DATA_LOCATION=./data
PAPERLESS_MEDIA_LOCATION=./media
PAPERLESS_CONSUME_LOCATION=./consume
PAPERLESS_EXPORT_LOCATION=./export

# Generieren, z.B.: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
PAPERLESS_DBPASS=change-me
