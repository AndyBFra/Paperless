###############################################################################
# Nach docker-compose.env kopieren und anpassen.                              #
# Alle Optionen: https://docs.paperless-ngx.com/configuration/                #
###############################################################################

# Generieren: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=change-me

PAPERLESS_TIME_ZONE=Europe/Berlin

PAPERLESS_OCR_LANGUAGE=deu+eng

# uid/gid des Colima-VM-Users (colima ssh -- id)
USERMAP_UID=503
USERMAP_GID=1000

PAPERLESS_URL=http://andyserver.fritz.box:8000

PAPERLESS_CONSUMER_RECURSIVE=true
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=true
PAPERLESS_CONSUMER_POLLING_INTERVAL=30

# Sonst wird eine exakte Datei-Dublette in consume/ nur geloggt, aber trotzdem
# als neues Dokument angelegt.
PAPERLESS_CONSUMER_DELETE_DUPLICATES=true
